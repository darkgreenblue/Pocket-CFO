# ---- Pocket CFO (CFO جیبی) — فقط کلیدهای محرمانه ----
# یک کپی به اسم `.env` بساز و این سه مقدار را پر کن. این فایل در .gitignore است
# و هیچ‌وقت به گیت push نمی‌شود.
#
# بقیه‌ی تنظیمات (مدل‌ها، تایم‌اوت، واحد، ساعت یادآوری) داخل کد در
# bot/config.py هستند تا تغییرشان فقط با ویرایش کد و push انجام شود — نه
# دستکاری سرور.

# توکن رباتی که از @BotFather می‌گیری
TELEGRAM_BOT_TOKEN=

# کلید OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# آی‌دی عددی تلگرام خودت (از @userinfobot). برای چند نفر با , جدا کن.
# اگر خالی بماند، ربات به همه پاسخ می‌دهد.
ALLOWED_USER_IDS=

# ---- درِ دومِ ورودی: میان‌برِ iOS (اختیاری) ----
# آدرسی که گوشیِ کاربر می‌بیند — همین یک خط کافی است.
# بعد از ست‌کردنش، هر کاربر در تلگرام /shortcut می‌زند و لینکِ شخصیِ خودش را می‌گیرد؛
# برای کاربرِ تازه نه اینجا را دست می‌زنی نه سرور را ری‌استارت می‌کنی.
# اگر خالی بماند، سرورِ HTTP بالا نمی‌آید و ربات فقط از تلگرام ورودی می‌گیرد.
INGEST_PUBLIC_URL=

# (اختیاری، مسیرِ قدیمی) توکنِ ثابت، برای وقتی نمی‌خواهی از /shortcut استفاده کنی.
# قالب: <user_id>:<token> و برای چند نفر با , جدا کن. حداقل ۲۴ کاراکتر.
INGEST_TOKENS=
