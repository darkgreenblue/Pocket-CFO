# ---- Pocket CFO (CFO جیبی) configuration ----
# این فایل فقط نام متغیرهاست. یک کپی به اسم `.env` بساز و مقادیر را پر کن.
# فایل `.env` در .gitignore است و هیچ‌وقت به گیت push نمی‌شود.

# توکن رباتی که از @BotFather می‌گیری
TELEGRAM_BOT_TOKEN=

# کلید OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# مدل‌های زنجیره‌ی LLM (تلاش اول و فال‌بک)
LLM_PRIMARY_MODEL=google/gemini-2.5-flash
LLM_FALLBACK_MODEL=google/gemini-2.5-flash-lite
LLM_TIMEOUT=15
LLM_RETRY_DELAY=5

# آی‌دی عددی تلگرام خودت (برای محدودسازی ربات شخصی). چندتا را با , جدا کن.
# اگر خالی بماند، ربات به همه پاسخ می‌دهد. آی‌دی‌ات را از @userinfobot بگیر.
ALLOWED_USER_IDS=

# واحد پیش‌فرض نمایش مبلغ: toman یا rial
DEFAULT_CURRENCY=toman

# ساعت یادآوری شبانه (۰ تا ۲۳، به وقت تهران)
REMINDER_HOUR=22

# مسیر دیتابیس SQLite
DB_PATH=data/pocket_cfo.db
