# ---- Pocket CFO (CFO جیبی) — فقط کلیدهای محرمانه ----
# یک کپی به اسم `.env` بساز و این سه مقدار را پر کن. این فایل در .gitignore است
# و هیچ‌وقت به گیت push نمی‌شود.
#
# بقیه‌ی تنظیمات (مدل‌ها، تایم‌اوت، واحد، ساعت یادآوری) داخل کد در
# bot/config.py هستند تا تغییرشان فقط با ویرایش کد و push انجام شود — نه
# دستکاری سرور.

# توکن رباتی که از @BotFather می‌گیری
TELEGRAM_BOT_TOKEN=

# کلید OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# آی‌دی عددی تلگرام خودت (از @userinfobot). برای چند نفر با , جدا کن.
# اگر خالی بماند، ربات به همه پاسخ می‌دهد.
ALLOWED_USER_IDS=

# ---- درِ دومِ ورودی: میان‌برِ iOS (اختیاری) ----
# اگر خالی بماند، سرورِ HTTP اصلاً بالا نمی‌آید و ربات فقط از تلگرام ورودی می‌گیرد.
# قالب: <user_id>:<token> و برای چند نفر با , جدا کن. توکن باید حداقل ۲۴ کاراکتر
# باشد (توکنِ کوتاه‌تر نادیده گرفته می‌شود) — این کلیدِ نوشتن روی دفترِ مالی است.
# ساختنِ توکن:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKENS=
